# Live state — the queue is runtime state, not source
queue.db
queue.db-wal
queue.db-shm
*.db-wal
*.db-shm
queue.db.bak-*

# Self-update timestamped backups (worker swaps the .py, keeps a .bak-<ts>)
*.bak-*

# Bare lab repo — separately managed (git://) and repaired; do not nest
lab.git/

# On-hive bare MIRROR of the ADO product repo (multi-GB packs) — runtime-fetched,
# never source. Must be ignored or `git add -A` vacuums the whole 1.2 GB pack.
ActiveRoles.git/
*.git/

# Worker scratch clones
workspace/
runs/

# Secrets live in ~/.hive/ (outside this tree); never vendor them here
*.token
.hive/
hive.env

# TLS material — the lab CA/server cert+key live in ~/.hive-ca/ (outside this
# tree). Guard against ever committing key/cert material if a run drops it here.
*.key
*.crt
*.pem
*.csr
*.srl

# Python
__pycache__/
*.pyc
winsw.exe
