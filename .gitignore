# Live state — the queue is runtime state, not source
queue.db
queue.db-wal
queue.db-shm
*.db-wal
*.db-shm

# Bare lab repo — separately managed (git://) and repaired; do not nest
lab.git/

# Worker scratch clones
workspace/
runs/

# Secrets live in ~/.hive/ (outside this tree); never vendor them here
*.token
.hive/
hive.env

# TLS material — the lab CA/server cert+key live in ~/.hive-ca/ (outside this
# tree). Guard against ever committing key/cert material if a run drops it here.
*.key
*.crt
*.pem
*.csr
*.srl

# Python
__pycache__/
*.pyc
winsw.exe
