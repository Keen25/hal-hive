[Unit]
Description=HAL Live Hive — lab.git smart-HTTP transport (replaces git:// for reliable Windows push)
Documentation=https://gist.github.com/Keen25/08d90e38b9a9aad47120ef8e8b38036b
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hive
EnvironmentFile=-%h/.hive/hive.env
# git:// push deadlocks the Git-for-Windows client (sideband/pipe-buffer
# half-duplex deadlock in receive-pack). Smart-HTTP is fully request/response
# framed and does not hit that bug, so remote workers clone+push over this.
# Bind default is localhost + lab NIC (S2 #5); set GIT_HTTP_BIND=0.0.0.0 in the
# env file for all interfaces, or HIVE_LAB_IP if the lab NIC != 192.168.100.1.
Environment=GIT_HTTP_PORT=8418
Environment=GIT_PROJECT_ROOT=%h/hive
Environment=GIT_HTTP_BACKEND=/usr/libexec/git-core/git-http-backend
ExecStartPre=/usr/bin/touch %h/hive/lab.git/git-daemon-export-ok
ExecStart=/usr/bin/python3 %h/hive/git_http_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
